# AgentMesh server-lite — copy to .env and fill in values

# Server
PORT=8080
NODE_ENV=development
LOG_FORMAT=dev
CORS_ORIGINS=*
AGENTMESH_VERSION=0.0.0

# Database — SQLite (default: in-memory, set a path for persistence)
DB_PATH=./data/agentmesh.sqlite

# AI Providers (at least one needed for agent tasks)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Company-brain vector search
# Production: use openai or gemini with pgvector.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_ATTEMPTS=4
EMBEDDING_CONCURRENCY=8
VECTOR_STORE=pgvector
VECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentmesh
VECTOR_HNSW_EF_SEARCH=100
# Local-only escape hatches. Keep false in deployed environments.
ALLOW_DETERMINISTIC_EMBEDDINGS=false
ALLOW_IN_MEMORY_VECTOR_STORE=false

# Sandbox — E2B (needed for code execution tasks)
E2B_API_KEY=

# Observability — Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# AMQP / RabbitMQ Queue Provider Config (optional)
QUEUE_PROVIDER=sqlite
RABBITMQ_URL=amqp://localhost:5672

# Redis (optional) — distributed lock + cache. Unset = single-node in-process
# fallback. Set this to make cron firing safe across multiple server instances.
REDIS_URL=redis://localhost:6379

# Incoming webhooks (optional) — signature verification secrets. A provider's
# webhook endpoint fails closed (401) until its secret is set.
# HMAC signing secret from your Slack app's Basic Information page (verifies x-slack-signature).
SLACK_SIGNING_SECRET=
# Secret configured on the GitHub webhook (verifies x-hub-signature-256).
GITHUB_WEBHOOK_SECRET=

# Neo4j durable graph "memory" (optional). When NEO4J_URI is set the graph store
# persists to Neo4j and survives restart; unset = in-memory fallback.
NEO4J_URI=bolt://localhost:7687
# Neo4j auth user (defaults to "neo4j" if unset).
NEO4J_USER=neo4j
# Neo4j password. Required whenever NEO4J_URI is set (refuses to connect with a
# default password). Must match docker-compose NEO4J_AUTH.
NEO4J_PASSWORD=agentmesh-dev


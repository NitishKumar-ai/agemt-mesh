{
  "name": "agentmesh-ts",
  "version": "0.1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript transformation of AgentMesh — durable engine for the 24/7 Agent Mesh OS",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "node server-lite/dist/index.js",
    "start:all": "pnpm --filter agent-mesh-frontend build && pnpm build && pnpm start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "axios": "^1.18.0"
  }
}


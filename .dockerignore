# Git/VCS
.git
.gitignore
.gitattributes
.github

# IDE/editor
.idea
.vscode
.classpath
.project
.settings
*.iml

# OS/filesystem noise
.DS_Store

# Caches & temp
**/.gradle
**/.cache
**/tmp
**/logs
**/*.log

# Build outputs (keep source in docker build)
**/build
!ui/build
**/out
**/target
**/dist
!ui-next/dist
**/coverage

# Incremental tsc state — must NOT be copied in, or `tsc -b` skips emitting
# declarations (it trusts the buildinfo while dist/ above is excluded).
**/*.tsbuildinfo

# Python
venv
**/__pycache__/
**/.pytest_cache/

# JS tooling
**/node_modules
**/.npm
**/.yarn
**/.pnpm-store
**/.eslintcache
**/.parcel-cache
**/.next

# Secrets — never bake env files into an image (runtime env is injected)
.env
.env.*
!.env.example
.vercel

# Large media / scratch not needed at runtime (UI public assets are kept)
/*.mp4
scratch

# Nested workspace not part of server-lite build graph
company-knowledge-os


{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agentmesh-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "agent-mesh-frontend", "run", "dev"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "server-lite",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agentmesh/server-lite", "run", "dev"],
      "port": 8080,
      "autoPort": false,
      "env": {
        "PORT": "8080",
        "NODE_ENV": "development",
        "DB_PATH": ":memory:",
        "DEMO_AUTH": "true",
        "DEMO_SEED": "true"
      }
    }
  ]
}

# ── LLM Models ────────────────────────────────────────────────────────────────
# Override any tier with a LiteLLM-compatible model string.
# See: https://docs.litellm.ai/docs/providers
MODEL_PLAN=gemini/gemini-2.5-flash-lite-preview-06-17
MODEL_EXECUTE=anthropic/claude-sonnet-4-6

# ── LLM API Keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...   # only needed if using openai/* models

# ── Hugging Face (ML intern harness) ─────────────────────────────────────────
# Used by ResearcherAgent for NER, zero-shot risk classification, and audience
# deduplication via sentence embeddings. Free tier (~10 req/hr anonymous).
# Get a token at https://huggingface.co/settings/tokens (read-only is fine)
# Models used:
#   dslim/bert-base-NER                         — entity extraction
#   MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli — zero-shot risk classification
#   sentence-transformers/all-MiniLM-L6-v2       — audience deduplication
HF_API_TOKEN=hf_...
# Cosine similarity threshold for audience deduplication (default 0.85).
# Increase to allow more similar campaigns; decrease to block near-duplicates.
HF_DEDUP_THRESHOLD=0.85

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create a GitHub OAuth App at https://github.com/settings/developers
# Homepage URL: http://127.0.0.1:5173
# Authorization callback URL: http://127.0.0.1:8000/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8000/api/github/callback
GITHUB_FRONTEND_URL=http://127.0.0.1:5173
GITHUB_OAUTH_SCOPE="read:user repo"

# 32-byte random key for encrypting stored GitHub access tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=

# ── E2B Sandbox ───────────────────────────────────────────────────────────────
# Required for CommitGuard code execution sandbox.
# Get a key at https://e2b.dev
E2B_API_KEY=

# ── CommitGuard ───────────────────────────────────────────────────────────────
# Optional: webhook URL to receive scan completion notifications (e.g. Render deploy hook)
COMMITGUARD_WEBHOOK_URL=

# ── Observability (optional) ──────────────────────────────────────────────────
# Traceloop — traces LLM calls via OpenTelemetry
TRACELOOP_API_KEY=

# Langfuse — LLM observability and prompt management
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── DBOS / Database ───────────────────────────────────────────────────────────
# DBOS reads its connection string from dbos-config.yaml by default.
# Set DBOS_DATABASE_URL to override for environments that inject it via env.
# DBOS_DATABASE_URL=postgresql://user:password@localhost:5432/agent_mesh
